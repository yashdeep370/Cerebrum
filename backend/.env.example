# --- LLM provider ---
# "groq" (free tier, use while developing) or "anthropic" (production)
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Research ---
TAVILY_API_KEY=

# --- Storage ---
# Everything (documents, chunks, chat history) lives in this one database — no local
# disk is used, so it's safe on hosts with an ephemeral filesystem. SQLite by default
# (zero setup). For a host without a persistent volume, swap in a free hosted Postgres,
# e.g. Neon (neon.tech): postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./storage/cerebrum.db

# --- App ---
CORS_ORIGINS=http://localhost:3000

# Shared password protecting the whole API. Leave empty for local dev (no gate).
# Set this before deploying publicly so your free LLM/search quota isn't open to anyone.
APP_PASSWORD=
